# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal content: the real knowledge base stays out of the repository
/knowledge/

# personal branding (optional favicon set dropped into public/)
/public/favicon.ico
/public/favicon.svg
/public/favicon-16x16.png
/public/favicon-32x32.png
/public/apple-touch-icon.png
/public/android-chrome-192x192.png
/public/android-chrome-512x512.png
/public/site.webmanifest

# answers remembered by start.sh between runs (no secrets)
.setup-answers
.setup-answers.tmp

# local tooling and editors
.claude/
.idea/
.vscode/
*.log
*.local

# database dumps and backups
*.sql
!prisma/migrations/**/*.sql
*.dump
*.bak
